# TLS certs — generated at runtime by the `ca` container into the tls_certs
# Docker volume, not into a repo folder anymore. Rule kept in case anything
# still writes here locally.
nginx/certs/*.key
nginx/certs/*.crt
nginx/certs/*.pem

# Docker
docker-compose.override.yml
