# Copy to .env.prod on the VPS and fill in real values. Never commit .env.prod.
# Use long, random secrets here — these are NOT the dev placeholders.

# ---------- Docker Hub ----------
DOCKERHUB_USER=yourdockerhubuser
TAG=latest

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=liberta_hotel
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# ---------- admin-service (read-only DB user, see database/grants.sql) ----------
ADMIN_DB_USERNAME=admin_ro
ADMIN_DB_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- JWT ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=7d

# ---------- Internal service-to-service auth (auth-service <-> mfa-service) ----------
# Required by both services (Joi .required(), min 32 chars) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_KEY=
AUTH_SERVICE_URL=http://auth-service:3001

# ---------- MFA ----------
MFA_TEMP_TOKEN_TTL_SECONDS=300
TOTP_ISSUER="LIBERTA หัวหิน"

# ---------- Booking draft lock ----------
BOOKING_DRAFT_LOCK_MINUTES=15

# ---------- TLS (used by scripts/generate-tls.sh) ----------
VPS_IP=
