# Copy to .env and fill in real values. Never commit .env.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=liberta_hotel
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme

# ---------- MySQL: admin-service read-only user (see database/grants.sql) ----------
ADMIN_DB_USERNAME=admin_ro
ADMIN_DB_PASSWORD=changeme-admin-ro-password

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- JWT ----------
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=7d

# ---------- Internal service-to-service auth (auth-service <-> mfa-service) ----------
# Required by both services (Joi .required(), min 32 chars) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_KEY=changeme-internal-service-key-needs-32-chars-min
AUTH_SERVICE_URL=http://auth-service:3001

# ---------- MFA ----------
MFA_TEMP_TOKEN_TTL_SECONDS=300
TOTP_ISSUER="LIBERTA หัวหิน"

# ---------- Booking draft lock ----------
BOOKING_DRAFT_LOCK_MINUTES=15

# ---------- Booking payment slip uploads ----------
BOOKING_SLIP_UPLOAD_DIR=/app/uploads/slips
BOOKING_SLIP_MAX_SIZE_BYTES=5242880

# ---------- Admin dashboard ----------
DASHBOARD_CACHE_TTL_SECONDS=60

# ---------- Service ports (host-side, for local dev without Docker) ----------
AUTH_SERVICE_PORT=3001
MFA_SERVICE_PORT=3002
GUEST_SERVICE_PORT=3003
ROOM_SERVICE_PORT=3004
BOOKING_SERVICE_PORT=3005
ADMIN_SERVICE_PORT=3006
