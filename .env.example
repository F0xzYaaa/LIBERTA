################################################################################
# LIBERTA HUAHIN - ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy to .env and fill in real values. Never commit .env.
# SECURITY: Never commit this file to version control.
################################################################################

################################################################################
# 1. MYSQL DATABASE CONFIGURATION
################################################################################

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=liberta_hotel

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=liberta_hotel

################################################################################
# 2. MYSQL: ADMIN-SERVICE READ-ONLY USER
# See database/grants.sql - GRANT SELECT only, enforced at the DB level.
################################################################################

ADMIN_DB_USERNAME=admin_ro
ADMIN_DB_PASSWORD=changeme-admin-ro-password

################################################################################
# 3. REDIS CONFIGURATION
################################################################################

REDIS_HOST=localhost
REDIS_PORT=6379

################################################################################
# 4. JWT / STAFF AUTHENTICATION
################################################################################

JWT_ACCESS_SECRET=changeme-access-secret-needs-32-chars-min
JWT_REFRESH_SECRET=changeme-refresh-secret-needs-32-chars-min

JWT_ACCESS_EXPIRES=24h

# Staff/admin refresh token lifetime - 24h (was 7d, shortened 2026-07-11).
# JWT_REFRESH_TTL_SECONDS is the Redis-side value that actually enforces
# this and MUST be kept in sync with JWT_REFRESH_EXPIRES above.
JWT_REFRESH_EXPIRES=24h
JWT_REFRESH_TTL_SECONDS=86400

################################################################################
# 5. INTERNAL SERVICE-TO-SERVICE AUTH (auth-service <-> mfa-service)
################################################################################

INTERNAL_SERVICE_KEY=changeme-internal-service-key-needs-32-chars-min

# Docker mode: docker-compose.yml overrides this to http://auth-service:3001
# for mfa-service. This localhost default is for local `npm run dev` only.
AUTH_SERVICE_URL=http://localhost:3001

################################################################################
# 6. MFA (TOTP) CONFIGURATION
################################################################################

MFA_TEMP_TOKEN_TTL_SECONDS=300
TOTP_ISSUER="LIBERTA HUAHIN"

################################################################################
# 7. LOGIN LOCKOUT (brute-force protection)
################################################################################

# Using Joi defaults (5 attempts / 900s) - uncomment to override.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_WINDOW_SECONDS=900

################################################################################
# 8. BOOKING CONFIGURATION
################################################################################

BOOKING_DRAFT_LOCK_MINUTES=15

################################################################################
# 9. FILE UPLOADS (payment slips, room photos)
################################################################################

# Docker mode: docker-compose.yml overrides both of these to /app/uploads/...
# These relative defaults are for local `npm run dev` only.
BOOKING_SLIP_UPLOAD_DIR=./uploads/slips
ROOM_IMAGE_UPLOAD_DIR=./uploads/rooms
BOOKING_SLIP_MAX_SIZE_BYTES=5242880

################################################################################
# 10. ADMIN DASHBOARD
################################################################################

DASHBOARD_CACHE_TTL_SECONDS=60

################################################################################
# 11. SERVICE PORTS (host-side, for local dev without Docker)
################################################################################

AUTH_SERVICE_PORT=3001
MFA_SERVICE_PORT=3002
GUEST_SERVICE_PORT=3003
ROOM_SERVICE_PORT=3004
BOOKING_SERVICE_PORT=3005
ADMIN_SERVICE_PORT=3006

################################################################################
# 12. TLS / CERTIFICATE AUTHORITY (nginx HTTPS, see nginx/ca/)
################################################################################

# Common Name for nginx's self-signed server certificate, issued by the
# separate one-shot `ca` container into the shared tls_certs volume.
SERVER_CN=localhost
